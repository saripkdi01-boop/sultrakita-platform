{
  "name": "sultrakita-platform",
  "version": "2.0.0",
  "description": "Marketplace lokal untuk Kendari dan Sulawesi Tenggara",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "node scripts/lint-check.js",
    "test": "node --test",
    "build": "node scripts/build-check.js",
    "test:security": "node scripts/security-regression.js",
    "smoke:api": "node scripts/api-smoke.js",
    "smoke:donation": "node scripts/donation-smoke.js",
    "e2e:marketplace": "node scripts/local-marketplace-e2e.js",
    "audit:production": "node scripts/production-audit.js",
    "test:webhook": "node scripts/send-donation-webhook.js",
    "load:donation": "node scripts/load-test-donations.js",
    "e2e:sandbox": "node scripts/sandbox-donation-e2e.js",
    "db:migrate:postgres": "node scripts/migrate-postgres.js",
    "db:backup:postgres": "bash scripts/backup-postgres.sh",
    "db:restore:postgres": "bash scripts/restore-postgres.sh",
    "check:modernization": "node scripts/modernization-check.js",
    "verify:local": "npm run lint && npm test && npm run build && npm run test:security && npm run smoke:api && npm run smoke:donation",
    "db:migrate": "node scripts/migrate-postgres.js",
    "check:single-runtime": "node scripts/modernization-check.js"
  },
  "keywords": [
    "marketplace",
    "kendari",
    "sulawesi-tenggara",
    "umkm"
  ],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "pg": "^8.23.0"
  }
}
