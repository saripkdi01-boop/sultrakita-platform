{
  "name": "sultrakita-platform",
  "version": "2.0.0",
  "description": "Marketplace lokal untuk Kendari dan Sulawesi Tenggara",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "node scripts/lint-check.js",
    "test": "node --test",
    "build": "node scripts/build-check.js",
    "test:security": "node scripts/security-regression.js",
    "smoke:api": "node scripts/api-smoke.js",
    "verify:local": "npm run lint && npm test && npm run build && npm run test:security && npm run smoke:api"
  },
  "keywords": ["marketplace", "kendari", "sulawesi-tenggara", "umkm"],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "sql.js": "^1.14.1"
  }
}
