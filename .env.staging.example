# Staging only. Store real values in GitHub Environment `staging` or Vercel Preview secrets.
NODE_ENV=staging
PUBLIC_SITE_URL=https://staging.sultrakita-platform.example
DATABASE_URL=postgresql://<staging-user>:<staging-password>@<staging-host>:5432/<staging-db>
DATABASE_SSL=true
DATABASE_POOL_MAX=5
CORS_ORIGINS=https://staging.sultrakita-platform.example
OTP_DEV_MODE=false
SEED_DEMO=false
R2_UPLOAD_URL=
R2_UPLOAD_TOKEN=
R2_PUBLIC_BASE_URL=
R2_PRESIGN_URL=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
