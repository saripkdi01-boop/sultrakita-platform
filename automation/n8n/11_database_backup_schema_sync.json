      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        690,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/automation_events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({event: \"Resend admin digest\", source: \"n8n\", idempotency_key: $json.idempotency_key || $execution.id}) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "resend_admin_digest",
      "name": "Resend admin digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        920,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Non-sensitive error normalization. Never log payment keys or PII.\nreturn [{json:{ok:false, workflow: \"11_database_backup_schema_sync\", execution_id:$execution.id, retryable:true}}];"
      },
      "id": "error_handler",
      "name": "Error Handler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1150,
        180
      ]
    }
