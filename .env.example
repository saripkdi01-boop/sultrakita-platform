# Public URL and explicit CORS allowlist
PUBLIC_SITE_URL=https://sultrakita-platform.vercel.app
CORS_ORIGINS=http://localhost:3000,https://sultrakita-platform.vercel.app

# Production database: Supabase transaction pooler or managed PostgreSQL
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Durable object storage (Cloudflare R2 gateway or compatible endpoint)
R2_UPLOAD_URL=
R2_UPLOAD_TOKEN=
R2_PUBLIC_BASE_URL=
# Optional provider endpoint that returns short-lived signed upload URLs
R2_PRESIGN_URL=

# OTP provider; WhatsApp Cloud API template is preferred for production
# Never enable dev mode in production

OTP_DEV_MODE=false
OTP_PROVIDER_URL=
OTP_PROVIDER_TOKEN=
OTP_PROVIDER_CHANNEL=whatsapp
# Email OTP: gunakan resend untuk direct API, atau generic untuk endpoint kompatibel
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_PROVIDER_URL=https://api.resend.com/emails
EMAIL_PROVIDER_TOKEN=
EMAIL_FROM=no-reply@sultrakita.id
EMAIL_REPLY_TO=halo@sultrakita.id

# Google OAuth / OpenID Connect (login & daftar cepat; tidak membaca inbox Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sultrakita-platform.vercel.app/api/auth/google/callback
OTP_DESTINATION_PEPPER=

# WhatsApp Cloud API notifications
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=sultrakita_new_message
WHATSAPP_TEMPLATE_LANGUAGE=id
# Approved Meta template with one body variable containing the numeric OTP
WHATSAPP_OTP_TEMPLATE_NAME=sultrakita_otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=id

# Admin and payment secrets; store only in Vercel/Supabase secret manager
ADMIN_TOKEN=
PAYMENT_PROVIDER=
MIDTRANS_MODE=sandbox
MIDTRANS_SERVER_KEY=
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_REFUND_URL=https://api.xendit.co/refunds
PAYMENT_SUCCESS_URL=https://sultrakita-platform.vercel.app/?donation=success
PAYMENT_FAILURE_URL=https://sultrakita-platform.vercel.app/?donation=failed

# Analytics and backup operations
ANALYTICS_TRACK_PER_MINUTE=120
ANALYTICS_RETENTION_DAYS=90
BACKUP_DIR=./backups/postgres
BACKUP_RETENTION_DAYS=30
BACKUP_S3_URI=

# Demo seed is staging-only; never set this in production
SEED_DEMO=false


# Optional AI-assisted seller onboarding; server-side only, never expose these in VITE/public variables
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional authorized JSON feeds only; do not use scraped Shopee/Instagram pages
# Feed item shape: {id,title,url,category,city,province,price,image_url}
EXTERNAL_MARKETPLACE_FEEDS_JSON=[]
# Feed item shape: {id,title,company,url,city,province,category,employment_type,salary,posted_at,expires_at}
EXTERNAL_JOB_FEEDS_JSON=[]
# Optional comma-separated HTTPS hostnames allowed for admin URL metadata import
JOB_URL_ALLOWED_HOSTS=
# Additional HTTPS hosts for universal link cards; default covers common marketplaces and job portals
LINK_URL_ALLOWED_HOSTS=
# Optional server-side AI summarizer; leave empty to use the free local metadata fallback
AI_SUMMARY_PROVIDER=local
# Aulaa payment provider (server-side only)
AULAA_API_BASE=https://api.aulaa.co/v1
AULAA_API_KEY=
AULAA_WEBHOOK_SECRET=
AULAA_VA_METHOD=bca_va

# Telegram admin governance (server-side only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_WEBHOOK_SECRET=

# Optional public Supabase Realtime bootstrap (never use service-role key here)
SUPABASE_URL=
SUPABASE_ANON_KEY=
