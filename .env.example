PORT=3000
CORS_ORIGIN=http://localhost:5173
# Hanya untuk demo lokal; jangan aktifkan pada production tanpa provider OTP resmi.
OTP_DEV_MODE=false
# Adapter OTP generik; gunakan endpoint provider resmi Anda.
OTP_PROVIDER_URL=
OTP_PROVIDER_TOKEN=
OTP_PROVIDER_CHANNEL=sms
# WhatsApp Cloud API — jangan commit nilai token rahasia.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Lindungi dashboard admin dengan token panjang dari secret manager.
ADMIN_TOKEN=
# Opsional: endpoint upload gateway/R2 dan URL publik object storage.
R2_UPLOAD_URL=
R2_UPLOAD_TOKEN=
R2_PUBLIC_BASE_URL=
# Maksimal event per IP per menit untuk endpoint tracking.
ANALYTICS_TRACK_PER_MINUTE=120
# Retention analytics lokal Express, minimal 7 hari dan maksimal 730 hari.
ANALYTICS_RETENTION_DAYS=90
# Untuk deployment produksi, gunakan database dan object storage terkelola melalui secret manager.
