PORT=3000
CORS_ORIGIN=http://localhost:5173
# Hanya untuk demo lokal; jangan aktifkan pada production tanpa provider OTP resmi.
OTP_DEV_MODE=false
# Adapter OTP generik; gunakan endpoint provider resmi Anda.
OTP_PROVIDER_URL=
OTP_PROVIDER_TOKEN=
OTP_PROVIDER_CHANNEL=sms
# WhatsApp Cloud API — jangan commit nilai token rahasia.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=sultrakita_new_message
WHATSAPP_TEMPLATE_LANGUAGE=id
# Lindungi dashboard admin dengan token panjang dari secret manager.
ADMIN_TOKEN=
# Opsional: endpoint upload gateway/R2 dan URL publik object storage.
R2_UPLOAD_URL=
R2_UPLOAD_TOKEN=
R2_PUBLIC_BASE_URL=
# Maksimal event per IP per menit untuk endpoint tracking.
ANALYTICS_TRACK_PER_MINUTE=120
# Retention analytics lokal Express, minimal 7 hari dan maksimal 730 hari.
ANALYTICS_RETENTION_DAYS=90
# Payment provider donasi: pilih kosong untuk mode pending lokal, atau midtrans/xendit.
PAYMENT_PROVIDER=
# Midtrans: sandbox atau production; server key hanya di backend/secret manager.
MIDTRANS_MODE=sandbox
MIDTRANS_SERVER_KEY=
# Xendit: secret key hanya di backend/secret manager; webhook memakai callback token.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# Opsional: override URL Refund API Xendit bila account/API version berbeda.
XENDIT_REFUND_URL=https://api.xendit.co/refunds
# URL opsional setelah pembayaran Xendit.
PAYMENT_SUCCESS_URL=http://localhost:3000/?donation=success
PAYMENT_FAILURE_URL=http://localhost:3000/?donation=failed
# Untuk deployment produksi, gunakan database dan object storage terkelola melalui secret manager.
