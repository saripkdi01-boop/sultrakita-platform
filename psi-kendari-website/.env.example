# ============================================================
# PSI Kendari — contoh konfigurasi environment
# Salin menjadi .env.local untuk pengembangan lokal.
# JANGAN commit file .env/.env.local yang berisi nilai asli.
# ============================================================

# URL publik situs ini (tanpa garis miring di akhir).
# Dipakai untuk canonical URL, sitemap.xml, robots.txt, dan Open Graph.
SITE_URL=http://localhost:3000

# Basis WordPress REST API resmi psi.id (diambil di server, cache ISR).
# Ganti bila DPP menyediakan endpoint/mirror yang mengizinkan server ini.
PSI_API_BASE=https://psi.id/wp-json/wp/v2

# Basis API yang dipanggil dari BROWSER pengunjung bila server terblokir
# (fallback sisi klien). Kosongkan untuk memakai PSI_API_BASE.
NEXT_PUBLIC_PSI_API_BASE=https://psi.id/wp-json/wp/v2

# Interval revalidasi ISR (detik) untuk data psi.id & RSS. Default 900.
REVALIDATE_SECONDS=900

# Kontak (dipakai di halaman /kontak & formulir mailto). Kosongkan bila
# belum ada alamat email resmi — formulir akan disembunyikan.
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Analytics 4 (opsional). Kosongkan untuk menonaktifkan.
NEXT_PUBLIC_GA_ID=

# Lokasi folder aset logo resmi untuk `npm run logo` (opsional).
# Default: ../psi-logo-aset relatif terhadap folder proyek.
PSI_LOGO_DIR=

# Hanya untuk container/jaringan yang memakai HTTPS proxy (mis. sandbox CI):
# aktifkan agar fetch Node mengikuti HTTPS_PROXY. Tidak perlu di Vercel.
# NODE_USE_ENV_PROXY=1
