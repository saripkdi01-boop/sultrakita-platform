# Supabase is used for session/profile reads in the Next.js experience.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Express API origin. Leave empty only when Next.js and the API share the same origin.
NEXT_PUBLIC_API_BASE_URL=https://sultrakita-platform.vercel.app
# Public CDN URL only; never place R2 credentials in browser variables.
NEXT_PUBLIC_R2_BUCKET_URL=
