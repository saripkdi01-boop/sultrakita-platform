# Supabase is used for session/profile reads in the Next.js experience.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Express API origin. Leave empty only when Next.js and the API share the same origin.
NEXT_PUBLIC_SITE_URL=https://sukiapps.web.id
NEXT_PUBLIC_API_BASE_URL=https://sukiapps.web.id
# Nomor WhatsApp publik format internasional tanpa tanda + atau spasi.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional legacy Express Google OAuth gateway. Keep empty until a Supabase session bridge is deployed.
NEXT_PUBLIC_GOOGLE_OAUTH_GATEWAY_URL=
# Public CDN URL only; never place R2 credentials in browser variables.
NEXT_PUBLIC_R2_BUCKET_URL=
# Server-only R2/S3 credentials used by /api/profile/avatar. Do not prefix with NEXT_PUBLIC_.
R2_ENDPOINT=
# Alternatif endpoint: gunakan R2_S3_ENDPOINT atau R2_ACCOUNT_ID bila R2_ENDPOINT kosong.
R2_ACCOUNT_ID=
R2_S3_ENDPOINT=
R2_BUCKET=
# Alternatif nama bucket: R2_BUCKET_NAME.
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_REGION=auto
# Public WebSocket gateway URL for Suki Chat realtime.
# FASE 0 (2026-10-01): chat DINONAKTIFKAN sementara di produksi — biarkan KOSONG
# sampai gateway WS terpisah di-host. Lihat ARCHITECTURE.md bagian "Chat realtime".
# Contoh saat aktif: NEXT_PUBLIC_CHAT_WS_URL=wss://chat.sukiapps.web.id
NEXT_PUBLIC_CHAT_WS_URL=
# Server-only Gemini credentials. Never prefix with NEXT_PUBLIC_ or expose in client code.
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
# Server-only n8n webhook for WhatsApp notifications; never use NEXT_PUBLIC_ here.
N8N_WHATSAPP_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Server-only inquiry email notification. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@sultrakita.id
EMAIL_REPLY_TO=SultrakitaPlatform@gmail.com
SUPABASE_SERVICE_ROLE_KEY=

# --- SLICE-C: Billing SANDBOX (pembayaran nyata BELUM dikonfigurasi) ---
# Nilai "sandbox" = simulasi saja; jangan klaim transaksi nyata.
SUKI_BILLING_PROVIDER=sandbox
# Kosongkan sampai provider nyata disiapkan; webhook lalu wajib x-sandbox: true.
SUKI_BILLING_WEBHOOK_SECRET=
SUKI_BILLING_CURRENCY=IDR

# --- BILLING-LIVE SCAFFOLD: Xendit (mode TEST) ---
# Aktifkan pembayaran nyata: SUKI_BILLING_PROVIDER=xendit + isi XENDIT_API_KEY.
# Tanpa key ini, API mengembalikan 503 not_configured (jujur).
# JANGAN commit key asli ke repo — isi via Vercel env / .env.local saja.
# Test key diawali xnd_development_ | Live key diawali xnd_production_
XENDIT_API_KEY=
# Callback Verification Token dari dashboard Xendit (Settings -> Webhooks).
# WAJIB diisi agar webhook diterima; kosong = semua webhook ditolak 401.
XENDIT_CALLBACK_TOKEN=
# Guard anti-kecelakaan: kunci LIVE ditolak kecuali =true.
SUKI_BILLING_ALLOW_LIVE=false
